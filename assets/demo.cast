[13.6, "o", "$ rg -n -- IndexerPipeline . | wc -c\r\n"]
[14.49, "o", "5905   # the text baseline grows with the corpus\r\n"]
[15.83, "o", "$ scouter impact '.../utils.SafeCommand' internal/utils/safe_exec.go\r\n"]
[17.17, "o", "Risk Level: Low\r\nBlast Radius: 10 callers\r\n"]
[18.51, "o", "  - .../adapters/rtk.Reader.Read (rtk/reader.go)\r\n"]
[19.85, "o", "  - .../mcp.Server.handlePredict (handle_intelligence.go)\r\n"]
