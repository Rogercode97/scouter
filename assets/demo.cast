[22.52, "o", "  - ... (tests and fuzz)\r\n"]
[23.86, "o", "$ scouter propagate 'demo.Greet' 'rename:Welcome'\r\n"]
[24.75, "o", "\u2705 Transformation staged in Ledger for 1 files\r\n"]
[25.87, "o", "$ scouter diff\r\n"]
[26.98, "o", "-  func Greet(name string) string {\r\n+  func Welcome(name string) string {\r\n"]
[28.32, "o", "-    fmt.Println(Greet(\"scouter\"))\r\n+    fmt.Println(Welcome(\"scouter\"))\r\n"]
[29.44, "o", "$ scouter commit && go run .\r\n"]
[30.33, "o", "\u2705 Committed changes to 1 files\r\nhello scouter\r\n"]
