{"version": 2, "width": 100, "height": 28, "timestamp": 1761432000, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}, "title": "Scouter 30-second demo: index, search vs rg, impact, ledger commit"}
[1.11, "o", "$ scouter index .\r\n"]
[2.45, "o", "\u2705 Indexed .\r\n"]
[3.57, "o", "$ scouter search IndexerPipeline\r\n"]
[4.46, "o", "\ud83d\udd0d Search results for \"IndexerPipeline\":\r\n"]
[5.8, "o", "- [class] IndexerPipeline (internal/engine/indexer.go:51)\r\n"]
[7.14, "o", "- [function] NewIndexerPipeline (internal/engine/indexer.go:55)\r\n"]
[8.47, "o", "- [method] IndexerPipeline.Index (internal/engine/indexer.go:179)\r\n"]
[9.81, "o", "- [method] IndexerPipeline.indexDirectory (internal/engine/indexer.go:257)\r\n"]
